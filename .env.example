# =============================================================================
# KopiKini API — contoh environment variable (SALIN ke .env, JANGAN commit .env)
# Semua nilai di bawah adalah placeholder lokal, BUKAN kunci produksi.
# =============================================================================

NODE_ENV=development
PORT=3000

# PostgreSQL 16 lokal (lihat docker-compose.yml). Ganti user/password sesuai mesin Anda.
DATABASE_URL=postgres://kopikini:change-me-local@localhost:5432/kopikini
DATABASE_SSL=false

# JWT (TRD §6.1). Isi dengan string acak panjang, mis. hasil:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30

# Pepper untuk hash OTP & refresh token (string acak, minimal 32 karakter)
OTP_HASH_SECRET=
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
# Hanya untuk development: kembalikan kode OTP di respons (selalu dimatikan saat NODE_ENV=production)
OTP_DEV_ECHO=true

# Radius default pencarian gerai terdekat (AFD §3.1: delivery maks 7 km)
STORE_NEARBY_DEFAULT_RADIUS_KM=10
STORE_TIMEZONE=Asia/Jakarta

# Midtrans — SANDBOX SAJA, opsional, biarkan kosong bila belum ada kunci.
# Kosong = checkout tetap berhasil tanpa gateway (payment PENDING, tanpa QR/snap).
# Bila diisi, WAJIB kunci sandbox: SB-Mid-server-* dan SB-Mid-client-*.
# JANGAN isi kunci produksi di sini.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
